{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 공지 도우미",
  "version": "0.12.1",
  "identifier": "com.intocns.ainotice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI 공지 도우미",
        "width": 900,
        "height": 640,
        "minWidth": 480,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "ollama-runtime": "ollama-runtime"
    }
  }
}
